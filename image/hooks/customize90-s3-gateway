#!/bin/bash
# rpi-image-gen build hook: bakes the S3 Zigbee Gateway application into the
# golden image. Runs on the BUILD HOST against the target rootfs, which is
# passed in as $1 (rpi-image-gen's customize hook convention).
#
# What this does NOT do, on purpose, because it needs a live running system
# (systemd actually managing services, PostgreSQL actually accepting
# connections) which a build-time chroot does not have:
#   - create the PostgreSQL role/database/schema
#   - set a real GATEWAY_ID
#   - install a site's samplelist.csv / pygw_conf.py
#   - run s3-gateway-dbup
# Those all happen at first boot instead - see image/firstboot/.
#
# The local web admin (webadmin/ in the app source) IS installed here, mirroring
# scripts/install-webadmin.sh. That script can't run in a build chroot as-is
# (it prompts for a password and needs a live systemctl), so its steps are done
# offline instead: the login password comes from S3_WEBADMIN_PASSWORD in
# gateway-golden.yaml, and the per-unit cookie-signing key is generated on the
# unit's first start (see s3-gateway-webadmin-initkey below).
#
# The log policy (scripts/install-log-retention.sh) is likewise installed offline:
#   00:00 daily  s3-gateway-log-rotate.timer       new gateway.log / mqtt.log / error.log; the
#                                                  finished day goes to log/rotated/
#                                                  (config: /etc/s3-gateway/logrotate.conf)
#   09:00 daily  s3-gateway-log-maintenance.timer  gzip rotated logs > 7 days into log/compressed/,
#                                                  delete > 3 months
# Midnight / 09:00 are the unit's local time, i.e. locale.timezone in gateway-golden.yaml.
set -euo pipefail

ROOTFS="$1"
HOOK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_DIR="$(dirname "$HOOK_DIR")"
SRC="$PROJECT_DIR/s3-zigbee-gateway"
FIRSTBOOT_SRC="$PROJECT_DIR/firstboot"

SERVICE_USER="${S3_SERVICE_USER:-s3gw}"
TARGET_DIR="${S3_TARGET_DIR:-/opt/s3-gateway/app}"
OPERATOR_USER="${S3_OPERATOR_USER:-pi}"
OPERATOR_DIR="${S3_OPERATOR_DIR:-/home/pi/S3Gateway}"
SERVICE_NAME="s3-zigbee-gateway"

if [ ! -f "$SRC/requirements.txt" ] || [ ! -d "$SRC/PYSerialGateway" ]; then
    echo "ERROR: $SRC does not look like the s3-zigbee-gateway source tree." >&2
    echo "Unzip your s3-zigbee-gateway.zip into image/s3-zigbee-gateway/ first." >&2
    echo "See image/s3-zigbee-gateway/PUT_YOUR_REPO_HERE.txt" >&2
    exit 1
fi

# --- first-boot pre-flight: the bundled dbup MUST honor S3_DBUP_SKIP_RESTART ---
# s3-gateway-firstboot.service is ordered Before= the gateway service. If dbup
# calls `systemctl start s3-zigbee-gateway` from inside it, that start job waits
# for first-boot to finish while first-boot waits for the start: a permanent
# systemd job deadlock (`systemctl list-jobs` shows firstboot "running" forever
# and multi-user.target "waiting"). Refuse to build an image that has it.
if ! grep -q 'S3_DBUP_SKIP_RESTART' "$SRC/scripts/s3-gateway-dbup"; then
    echo "ERROR: $SRC/scripts/s3-gateway-dbup does not support S3_DBUP_SKIP_RESTART." >&2
    echo "Booting an image with it deadlocks systemd (first-boot <-> gateway start job)." >&2
    echo "Re-sync image/s3-zigbee-gateway/ from the patched source tree." >&2
    exit 1
fi

# --- web admin pre-flight: fail here, in seconds, not after the apt/pip steps ---
WEBADMIN_SERVICE="s3-gateway-webadmin"
for f in webadmin/app.py \
         deploy/systemd/s3-gateway-webadmin.service \
         deploy/sudoers/s3-gateway-webadmin \
         deploy/webadmin.env.example; do
    if [ ! -e "$SRC/$f" ]; then
        echo "ERROR: $SRC/$f is missing." >&2
        echo "image/s3-zigbee-gateway/ does not contain the web admin - re-sync it from the current source tree." >&2
        exit 1
    fi
done

# --- log retention pre-flight: same idea ---
for f in scripts/log-maintenance.sh \
         deploy/systemd/s3-gateway-log-rotate.service \
         deploy/systemd/s3-gateway-log-rotate.timer \
         deploy/systemd/s3-gateway-log-maintenance.timer; do
    if [ ! -e "$SRC/$f" ]; then
        echo "ERROR: $SRC/$f is missing." >&2
        echo "image/s3-zigbee-gateway/ does not contain the log retention service - re-sync it from the current source tree." >&2
        exit 1
    fi
done

# The rotation config below writes finished days into log/rotated/. A log-maintenance.sh
# from before the rotated/ + compressed/ layout would never compress or delete them.
if ! grep -q 'ROTATED_DIR' "$SRC/scripts/log-maintenance.sh"; then
    echo "ERROR: $SRC/scripts/log-maintenance.sh predates the log/rotated + log/compressed layout." >&2
    echo "Rotated logs would pile up unprocessed. Re-sync image/s3-zigbee-gateway/ from the current source tree." >&2
    exit 1
fi

WEBADMIN_PASSWORD="${S3_WEBADMIN_PASSWORD:-}"
if [ "${#WEBADMIN_PASSWORD}" -lt 8 ] || [ "$WEBADMIN_PASSWORD" = "CHANGE-ME-BEFORE-BUILDING" ]; then
    echo "ERROR: S3_WEBADMIN_PASSWORD is unset, shorter than 8 characters, or still the placeholder." >&2
    echo "Set env.S3_WEBADMIN_PASSWORD in image/gateway-golden.yaml (this is the web admin login for every unit built from the image)." >&2
    exit 1
fi

echo "==> Excluding wlan0 from systemd-networkd-wait-online (no WiFi profile is baked in, so wlan0 never gets a carrier - without this, wait-online fails every boot and delays s3-zigbee-gateway.service, which orders After=network-online.target)"
cat >> "$ROOTFS/etc/systemd/network/02-wlan0.network" <<'EOF'

[Link]
RequiredForOnline=no
EOF

echo "==> Ensuring required packages are installed"
# rpi-image-gen's own packages: section (in gateway-golden.yaml) DOES work,
# but its consuming hook (builtin/hooks/customize20-packages) runs AFTER all
# of this project's own hooks in the customize phase - too late for the venv
# creation a few lines below, which needs python3.13-venv/postgresql already
# present. Installing here explicitly is a real ordering requirement, not a
# workaround for something broken; customize20-packages re-running its own
# install later is a harmless no-op ("already the newest version").
chroot "$ROOTFS" apt-get update
chroot "$ROOTFS" apt-get install -y \
    git rsync acl sudo usbutils iproute2 logrotate \
    python3 python3-venv python3.13-venv python3-pip \
    postgresql postgresql-client \
    minicom

# ModemManager probes USB serial ports with AT commands and can corrupt traffic
# to the Zigbee module. Nothing in this image installs it; masking is cheap
# insurance against a future package pulling it in.
systemctl --root="$ROOTFS" mask ModemManager.service

echo "==> Copying application source into $ROOTFS$TARGET_DIR"
install -d -m 755 "$ROOTFS$TARGET_DIR"
rsync -a \
    --exclude=.git/ \
    --exclude=.env \
    --exclude=PYSerialGateway/log/ \
    --exclude=PYSerialGateway/errorlog/ \
    --exclude=PYSerialGateway/GPSlog/ \
    --exclude=pyserialgateway/log/ \
    --exclude=pyserialgateway/errorlog/ \
    --exclude='*.mqtt.db' \
    "$SRC/" "$ROOTFS$TARGET_DIR/"

echo "==> Creating service account and Python venv inside the image"
chroot "$ROOTFS" bash -c "
set -euo pipefail
id '$SERVICE_USER' >/dev/null 2>&1 || useradd --system --create-home --shell /usr/sbin/nologin '$SERVICE_USER'
usermod -a -G dialout '$SERVICE_USER'
# minicom (installed above) needs serial-port access for the operator login too.
usermod -a -G dialout '$OPERATOR_USER'
python3 -m venv '$TARGET_DIR/.venv'
'$TARGET_DIR/.venv/bin/pip' install --upgrade pip
'$TARGET_DIR/.venv/bin/pip' install -r '$TARGET_DIR/requirements.txt'
"

echo "==> Writing baseline .env (GATEWAY_ID left UNPROVISIONED on purpose)"
cp "$ROOTFS$TARGET_DIR/.env.example" "$ROOTFS$TARGET_DIR/.env"
sed -i "s/^DB_USER=.*/DB_USER=${SERVICE_USER}/" "$ROOTFS$TARGET_DIR/.env"
sed -i "s/^GATEWAY_ID=.*/GATEWAY_ID=UNPROVISIONED/" "$ROOTFS$TARGET_DIR/.env"
sed -i "s|^MQTT_LOG_FILE=.*|MQTT_LOG_FILE=${OPERATOR_DIR}/log/mqtt.log|" "$ROOTFS$TARGET_DIR/.env"
sed -i "s|^GATEWAY_LOG_DIR=.*|GATEWAY_LOG_DIR=${OPERATOR_DIR}/log|" "$ROOTFS$TARGET_DIR/.env"
sed -i "s|^GATEWAY_ERROR_LOG_DIR=.*|GATEWAY_ERROR_LOG_DIR=${OPERATOR_DIR}/log|" "$ROOTFS$TARGET_DIR/.env"
# If your fleet shares one production broker/credentials, uncomment and edit:
# sed -i "s/^MQTT_ENABLED=.*/MQTT_ENABLED=true/" "$ROOTFS$TARGET_DIR/.env"
# sed -i "s/^MQTT_BROKER=.*/MQTT_BROKER=60.49.248.65/" "$ROOTFS$TARGET_DIR/.env"
# sed -i "s/^MQTT_PORT=.*/MQTT_PORT=1884/" "$ROOTFS$TARGET_DIR/.env"
# sed -i "s/^MQTT_USERNAME=.*/MQTT_USERNAME=otbr/" "$ROOTFS$TARGET_DIR/.env"
# sed -i "s/^MQTT_PASSWORD=.*/MQTT_PASSWORD=senatraffic/" "$ROOTFS$TARGET_DIR/.env"
chroot "$ROOTFS" chown root:"$SERVICE_USER" "$TARGET_DIR/.env"
chroot "$ROOTFS" chmod 640 "$TARGET_DIR/.env"

echo "==> Seeding operator workspace at $OPERATOR_DIR"
install -d -m 755 "$ROOTFS$OPERATOR_DIR"
install -m 644 "$SRC/PYSerialGateway/samplelist.csv" "$ROOTFS$OPERATOR_DIR/samplelist.csv"
install -m 644 "$SRC/PYSerialGateway/pygw_conf.py" "$ROOTFS$OPERATOR_DIR/pygw_conf.py"
[ -f "$SRC/PYSerialGateway/README-OPERATOR.md" ] && install -m 644 "$SRC/PYSerialGateway/README-OPERATOR.md" "$ROOTFS$OPERATOR_DIR/README-OPERATOR.md"
chroot "$ROOTFS" chown -R "${OPERATOR_USER}:${OPERATOR_USER}" "$OPERATOR_DIR"

echo "==> Persisting operator identity for scripts that read /etc/s3-gateway/operator.conf"
install -d -m 755 "$ROOTFS/etc/s3-gateway"
cat > "$ROOTFS/etc/s3-gateway/operator.conf" <<EOF
S3_OPERATOR_USER=$OPERATOR_USER
S3_OPERATOR_GROUP=$OPERATOR_USER
S3_OPERATOR_HOME=/home/$OPERATOR_USER
S3_OPERATOR_DIR=$OPERATOR_DIR
EOF

echo "==> Installing systemd units, GPSUP override, sudoers, dbup wrapper"
install -m 644 "$SRC/deploy/systemd/s3-zigbee-gateway.service" "$ROOTFS/etc/systemd/system/${SERVICE_NAME}.service"
install -d -m 755 "$ROOTFS/etc/systemd/system/${SERVICE_NAME}.service.d"
install -m 644 "$SRC/deploy/systemd/s3-zigbee-gateway-gpsup.conf" \
    "$ROOTFS/etc/systemd/system/${SERVICE_NAME}.service.d/override.conf"
# NOTE: s3-gateway-firstboot.service declares "Before=${SERVICE_NAME}.service"
# (ordering only, no Requires=), so the gateway is held back until first-boot
# has written GATEWAY_ID and initialised the DB, then starts by itself. The
# first-boot script runs s3-gateway-dbup with S3_DBUP_SKIP_RESTART=1 so dbup
# never runs `systemctl stop/start` on the gateway from inside the unit that
# is ordered Before= it (that deadlocks systemd - see the pre-flight above).

install -m 440 "$SRC/deploy/sudoers/s3-gateway-hwreset" "$ROOTFS/etc/sudoers.d/s3-gateway-hwreset"
chroot "$ROOTFS" visudo -cf /etc/sudoers.d/s3-gateway-hwreset

install -m 755 "$SRC/scripts/s3-gateway-dbup" "$ROOTFS/usr/local/sbin/s3-gateway-dbup"

echo "==> Installing the log policy (mirrors install-log-retention.sh): midnight rotation + 09:00 retention"
# Rotation config. Deliberately NOT in /etc/logrotate.d/: the distro's own daily
# logrotate job would then rotate these files a second time, at a different hour.
# Same content as install-log-retention.sh writes; "su" matches the ownership set
# on the log dir/files further down (operator user, service group).
rm -f "$ROOTFS/etc/logrotate.d/s3-gateway"
install -d -m 755 "$ROOTFS/etc/s3-gateway" "$ROOTFS/var/lib/logrotate"
cat > "$ROOTFS/etc/s3-gateway/logrotate.conf" <<EOF
# Written by customize90-s3-gateway. Run by s3-gateway-log-rotate.timer at 00:00:00.
${OPERATOR_DIR}/log/gateway.log
${OPERATOR_DIR}/log/error.log
${OPERATOR_DIR}/log/mqtt.log {
    daily
    missingok
    notifempty
    rotate 365
    dateext
    dateformat .%Y-%m-%d
    olddir rotated
    createolddir 2775 ${OPERATOR_USER} ${SERVICE_USER}
    nocompress
    copytruncate
    su ${OPERATOR_USER} ${SERVICE_USER}
}
EOF
chmod 644 "$ROOTFS/etc/s3-gateway/logrotate.conf"

# Seed logrotate's state file with an old "last rotated" date for each log. Without
# this, the unit's FIRST run only records today's date and rotates nothing (logrotate
# never rotates a log it has not seen before), so the first midnight passes with no
# new log file. With it, the first 00:00 run rotates properly. install-log-retention.sh
# does the same job with today's date; an old date is equivalent for an image, because
# the build day is long past by the time a unit first boots. logrotate rewrites the
# state file itself on every run.
{
    echo "logrotate state -- version 2"
    for log in gateway error mqtt; do
        echo "\"${OPERATOR_DIR}/log/${log}.log\" 2000-1-1-0:0:0"
    done
} > "$ROOTFS/var/lib/logrotate/s3-gateway.status"
chmod 640 "$ROOTFS/var/lib/logrotate/s3-gateway.status"

install -m 755 "$SRC/scripts/log-maintenance.sh" "$ROOTFS/usr/local/sbin/s3-gateway-log-maintenance"
install -m 644 "$SRC/deploy/systemd/s3-gateway-log-rotate.service" \
    "$ROOTFS/etc/systemd/system/s3-gateway-log-rotate.service"
install -m 644 "$SRC/deploy/systemd/s3-gateway-log-rotate.timer" \
    "$ROOTFS/etc/systemd/system/s3-gateway-log-rotate.timer"
install -m 644 "$SRC/deploy/systemd/s3-gateway-log-maintenance.timer" \
    "$ROOTFS/etc/systemd/system/s3-gateway-log-maintenance.timer"
# Generated rather than copied: the repo's unit hard-codes /home/pi/S3Gateway/log.
cat > "$ROOTFS/etc/systemd/system/s3-gateway-log-maintenance.service" <<EOF
[Unit]
Description=S3 Gateway log retention (compress after 7 days, delete after 3 months)

[Service]
Type=oneshot
Environment=GATEWAY_LOG_DIR=${OPERATOR_DIR}/log
Environment=S3_OPERATOR_CONFIG=/etc/s3-gateway/operator.conf
ExecStart=/usr/local/sbin/s3-gateway-log-maintenance
Nice=10
IOSchedulingClass=idle
EOF
chmod 644 "$ROOTFS/etc/systemd/system/s3-gateway-log-maintenance.service"

echo "==> Privileged-path hardening (mirrors install-runtime-hardening.sh)"
chroot "$ROOTFS" bash -c "
set -euo pipefail
chown root:root '$TARGET_DIR' '$TARGET_DIR/pyserialgateway'
chmod 755 '$TARGET_DIR' '$TARGET_DIR/pyserialgateway'
chown root:root '$TARGET_DIR/pyserialgateway/hardware_reset.py' '$TARGET_DIR/pyserialgateway/config_PYproperties.py'
chmod 644 '$TARGET_DIR/pyserialgateway/hardware_reset.py' '$TARGET_DIR/pyserialgateway/config_PYproperties.py'
rm -rf '$TARGET_DIR/pyserialgateway/__pycache__'
"

echo "==> Configuring operator GPS access (log dir + GPSlog symlink)"
install -d -m 2775 "$ROOTFS$OPERATOR_DIR/log"
install -d -m 2775 "$ROOTFS$OPERATOR_DIR/GPSlog"
chroot "$ROOTFS" bash -c "
set -euo pipefail
chown ${OPERATOR_USER}:${SERVICE_USER} '$OPERATOR_DIR/log' '$OPERATOR_DIR/GPSlog'
setfacl -m u:${SERVICE_USER}:rwx '$OPERATOR_DIR/log' '$OPERATOR_DIR/GPSlog'
setfacl -d -m u:${SERVICE_USER}:rwx '$OPERATOR_DIR/log' '$OPERATOR_DIR/GPSlog'
setfacl -d -m m:rwx '$OPERATOR_DIR/log' '$OPERATOR_DIR/GPSlog'
setfacl -m u:${SERVICE_USER}:x /home/${OPERATOR_USER} '$OPERATOR_DIR'
# Rotated (plain, newest 7 days) and compressed (.gz) daily logs live in these two
# subfolders; same owner/mode as install-log-retention.sh creates. The rotate and
# retention jobs run as root, so only the operator needs to own them.
install -d -m 2775 '$OPERATOR_DIR/log/rotated' '$OPERATOR_DIR/log/compressed'
chown ${OPERATOR_USER}:${SERVICE_USER} '$OPERATOR_DIR/log/rotated' '$OPERATOR_DIR/log/compressed'
rm -rf '$TARGET_DIR/PYSerialGateway/GPSlog'
ln -s '$OPERATOR_DIR/GPSlog' '$TARGET_DIR/PYSerialGateway/GPSlog'
chown -h root:${SERVICE_USER} '$TARGET_DIR/PYSerialGateway/GPSlog'
"

echo "==> Symlinking in-app log dirs to the centralized operator log (hardware_reset.py writes here directly via a path relative to itself, not via GATEWAY_LOG_DIR)"
chroot "$ROOTFS" bash -c "
set -euo pipefail
for d in '$TARGET_DIR/PYSerialGateway/log' '$TARGET_DIR/PYSerialGateway/errorlog' '$TARGET_DIR/pyserialgateway/log' '$TARGET_DIR/pyserialgateway/errorlog'; do
    rm -rf \"\$d\"
    ln -s '$OPERATOR_DIR/log' \"\$d\"
    chown -h root:${SERVICE_USER} \"\$d\"
done
"

: > "$ROOTFS$OPERATOR_DIR/log/gateway.log"
: > "$ROOTFS$OPERATOR_DIR/log/error.log"
: > "$ROOTFS$OPERATOR_DIR/log/mqtt.log"
chroot "$ROOTFS" chown "${OPERATOR_USER}:${SERVICE_USER}" \
    "$OPERATOR_DIR/log/gateway.log" "$OPERATOR_DIR/log/error.log" "$OPERATOR_DIR/log/mqtt.log"
chroot "$ROOTFS" chmod 664 \
    "$OPERATOR_DIR/log/gateway.log" "$OPERATOR_DIR/log/error.log" "$OPERATOR_DIR/log/mqtt.log"

# Same check install-log-retention.sh runs: a bad rotation config should fail the
# build, not silently leave every unit with logs that never roll over. Debug mode
# only parses and reports; it rotates nothing and the state file is discarded.
if ! LR_CHECK="$(chroot "$ROOTFS" logrotate -d --state /tmp/s3-gateway-logrotate-check.status \
        /etc/s3-gateway/logrotate.conf 2>&1)"; then
    echo "ERROR: logrotate rejected /etc/s3-gateway/logrotate.conf:" >&2
    echo "$LR_CHECK" >&2
    exit 1
fi
rm -f "$ROOTFS/tmp/s3-gateway-logrotate-check.status"

echo "==> Installing the first-boot provisioning service"
install -d -m 755 "$ROOTFS/opt/s3-gateway/firstboot"
install -m 755 "$FIRSTBOOT_SRC/s3-gateway-firstboot.sh" "$ROOTFS/opt/s3-gateway/firstboot/s3-gateway-firstboot.sh"
install -m 644 "$FIRSTBOOT_SRC/s3-gateway-firstboot.service" "$ROOTFS/etc/systemd/system/s3-gateway-firstboot.service"
install -d -m 750 "$ROOTFS/var/lib/s3-gateway"
chroot "$ROOTFS" chown "$SERVICE_USER:$SERVICE_USER" /var/lib/s3-gateway

echo "==> Installing the local web admin (${WEBADMIN_SERVICE})"
# The webadmin/ package and its Python deps (Flask, waitress) are already in the
# image from the rsync + pip steps above. What's left is what install-webadmin.sh
# does: env file, sudo rule, systemd unit.
WEBADMIN_ENV="/etc/s3-gateway/webadmin.env"

# The service runs as the operator account, which must be able to read the package.
chroot "$ROOTFS" chown -R root:"$SERVICE_USER" "$TARGET_DIR/webadmin"
chroot "$ROOTFS" chmod -R go+rX,go-w "$TARGET_DIR/webadmin"

# Same import check install-webadmin.sh runs: catches a missing dependency now
# rather than as a crash-looping service on the unit.
chroot "$ROOTFS" env PYTHONDONTWRITEBYTECODE=1 "$TARGET_DIR/.venv/bin/python" \
    -c "import sys; sys.path.insert(0, '$TARGET_DIR'); import webadmin.app"

# Hash the build-time password with the image's own Werkzeug (what the app
# verifies with). Passed on stdin so it never appears in a process list or needs
# shell quoting.
WEBADMIN_HASH="$(printf '%s' "$WEBADMIN_PASSWORD" | chroot "$ROOTFS" env PYTHONDONTWRITEBYTECODE=1 \
    "$TARGET_DIR/.venv/bin/python" -c \
    'import sys; from werkzeug.security import generate_password_hash; print(generate_password_hash(sys.stdin.read()))')"
case "$WEBADMIN_HASH" in
    *'$'*'$'*) ;;   # werkzeug hashes look like  method:params$salt$digest
    *) echo "ERROR: could not generate the web admin password hash" >&2; exit 1 ;;
esac

install -d -m 755 "$ROOTFS/etc/s3-gateway"
install -m 600 "$SRC/deploy/webadmin.env.example" "$ROOTFS$WEBADMIN_ENV"
chroot "$ROOTFS" chown root:root "$WEBADMIN_ENV"
sed -i "s|^S3_WEBADMIN_PASSWORD_HASH=.*|S3_WEBADMIN_PASSWORD_HASH=${WEBADMIN_HASH}|" "$ROOTFS$WEBADMIN_ENV"
grep -qxF "S3_WEBADMIN_PASSWORD_HASH=${WEBADMIN_HASH}" "$ROOTFS$WEBADMIN_ENV" \
    || { echo "ERROR: failed to write the web admin password hash into $WEBADMIN_ENV" >&2; exit 1; }
# S3_WEBADMIN_SECRET_KEY is deliberately left empty here: the login cookies are
# signed with it, so a key baked into a shared golden image would let anyone who
# has the image forge a logged-in session on every gateway. Each unit generates
# its own on first start instead.
cat > "$ROOTFS/usr/local/sbin/s3-gateway-webadmin-initkey" <<'EOF'
#!/bin/bash
# Gives this gateway its own web admin cookie-signing key (no-op once set).
set -euo pipefail
ENV_FILE=/etc/s3-gateway/webadmin.env
grep -q '^S3_WEBADMIN_SECRET_KEY=' "$ENV_FILE" || echo 'S3_WEBADMIN_SECRET_KEY=' >> "$ENV_FILE"
if grep -q '^S3_WEBADMIN_SECRET_KEY=.\+' "$ENV_FILE"; then
    exit 0
fi
KEY="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
sed -i "s|^S3_WEBADMIN_SECRET_KEY=.*|S3_WEBADMIN_SECRET_KEY=${KEY}|" "$ENV_FILE"
EOF
chmod 755 "$ROOTFS/usr/local/sbin/s3-gateway-webadmin-initkey"

# The only privilege the web admin gets: passwordless sudo for s3-gateway-dbup
# (its "Apply" button). Same rule and validation as install-webadmin.sh.
# sudoers requires fully-qualified command paths, so the template's __SYSTEMCTL__
# placeholder (used by its `reboot` rule) is resolved to the absolute path of
# systemctl as it exists INSIDE the target rootfs (usrmerge: /bin -> usr/bin).
SYSTEMCTL_BIN=""
for cand in /usr/bin/systemctl /bin/systemctl; do
    if [ -x "$ROOTFS$cand" ]; then SYSTEMCTL_BIN="$cand"; break; fi
done
[ -n "$SYSTEMCTL_BIN" ] || { echo "ERROR: systemctl not found in the target rootfs; cannot render the web admin sudoers file." >&2; exit 1; }

sed -e "s|__OPERATOR_USER__|${OPERATOR_USER}|g" -e "s|__SYSTEMCTL__|${SYSTEMCTL_BIN}|g" \
    "$SRC/deploy/sudoers/s3-gateway-webadmin" \
    > "$ROOTFS/etc/sudoers.d/s3-gateway-webadmin"
# Fail with a clear message if the template grows a placeholder this hook doesn't know about.
if grep -nE '__[A-Z0-9_]+__' "$ROOTFS/etc/sudoers.d/s3-gateway-webadmin" >&2; then
    echo "ERROR: unsubstituted placeholder(s) left in s3-gateway-webadmin sudoers (see lines above)." >&2
    rm -f "$ROOTFS/etc/sudoers.d/s3-gateway-webadmin"
    exit 1
fi
chmod 440 "$ROOTFS/etc/sudoers.d/s3-gateway-webadmin"
chroot "$ROOTFS" chown root:root /etc/sudoers.d/s3-gateway-webadmin
chroot "$ROOTFS" visudo -cf /etc/sudoers.d/s3-gateway-webadmin

sed -e "s|__OPERATOR_USER__|${OPERATOR_USER}|g" -e "s|__OPERATOR_DIR__|${OPERATOR_DIR}|g" \
    "$SRC/deploy/systemd/s3-gateway-webadmin.service" \
    > "$ROOTFS/etc/systemd/system/${WEBADMIN_SERVICE}.service"
chmod 644 "$ROOTFS/etc/systemd/system/${WEBADMIN_SERVICE}.service"
# Drop-in (rather than editing the project's unit): systemd re-reads
# EnvironmentFile after ExecStartPre, and "+" runs it as root despite User=.
install -d -m 755 "$ROOTFS/etc/systemd/system/${WEBADMIN_SERVICE}.service.d"
cat > "$ROOTFS/etc/systemd/system/${WEBADMIN_SERVICE}.service.d/10-initkey.conf" <<'EOF'
[Service]
ExecStartPre=+/usr/local/sbin/s3-gateway-webadmin-initkey
EOF

echo "==> Enabling units (offline, via systemctl --root - no live manager needed)"
systemctl --root="$ROOTFS" enable "${SERVICE_NAME}.service"
systemctl --root="$ROOTFS" enable "${WEBADMIN_SERVICE}.service"
